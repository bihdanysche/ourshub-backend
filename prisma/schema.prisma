generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                @id @default(autoincrement())
  tg_id             Int                @unique
  tg_sub            Int                @unique
  username          String             @unique
  name              String
  avatar            String?
  createdAt         DateTime           @default(now())
}