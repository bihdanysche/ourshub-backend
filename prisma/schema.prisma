generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int       @id @default(autoincrement())
  tg_id          Int       @unique
  tg_sub         String    @unique
  username       String?
  username_lower String?   @unique
  name           String
  avatar         String?
  createdAt      DateTime  @default(now())

  sessions       Session[]
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  ip         String
  agent      String
  location   String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}